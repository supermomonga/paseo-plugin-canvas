{
  "name": "paseo-canvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Workspace-shared GFM canvases for Paseo",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "visual:build": "node tests/visual/build.mjs",
    "build": "node scripts/build-renderer.mjs",
    "setup": "node scripts/build-renderer.mjs",
    "visual:serve": "node --import tsx tests/visual/serve.ts",
    "pretypecheck": "npm run build",
    "test:native": "node tests/native-smoke.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@resvg/resvg-wasm": "2.6.2",
    "diff": "7.0.0",
    "github-slugger": "^2.0.0",
    "micromark-util-decode-string": "2.0.1",
    "node-emoji": "2.2.0",
    "paseo-plugin-helper": "github:xpufx/paseo-plugin-helper#v0.4.0-beta.7",
    "proper-lockfile": "4.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@getpaseo/server": "0.8.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/diff": "7.0.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "~19.1.0",
    "@types/react-dom": "^19.1.11",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.25.0",
    "lucide-react-native": "0.546.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.14.0",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11"
  },
  "overrides": {
    "qs": "6.16.0",
    "@xmldom/xmldom": "0.9.12"
  }
