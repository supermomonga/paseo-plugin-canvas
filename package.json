{
  "name": "paseo-canvas",
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "description": "Write, review and share Markdown documents with the agents in your Paseo workspace.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "canvas",
    "markdown",
    "documents",
    "review",
    "mcp"
  ],
  "homepage": "https://github.com/supermomonga/paseo-plugin-canvas#readme",
  "bugs": "https://github.com/supermomonga/paseo-plugin-canvas/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermomonga/paseo-plugin-canvas.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "assets/",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "npm-shrinkwrap.json",
    "!server/assets/*.otf"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "visual:build": "node tests/visual/build.mjs",
    "build": "node scripts/build-renderer.mjs",
    "setup": "node scripts/build-renderer.mjs",
    "visual:serve": "node --import tsx tests/visual/serve.ts",
    "listing": "bash tests/listing/capture.sh",
    "pretypecheck": "npm run build",
    "test:native": "node tests/native-smoke.mjs",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "node scripts/build-renderer.mjs && node scripts/pack-manifest.mjs prepack",
    "postpack": "node scripts/pack-manifest.mjs postpack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-wasm": "2.6.2",
    "diff": "9.0.0",
    "github-slugger": "^2.0.0",
    "micromark-util-decode-string": "2.0.1",
    "node-emoji": "2.2.0",
    "proper-lockfile": "4.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@getpaseo/client": "0.17.3",
    "@getpaseo/plugin": "0.17.3",
    "@getpaseo/protocol": "0.17.3",
    "@getpaseo/server": "0.17.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@tanstack/react-query": "^5.90.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.28.2",
    "lucide-react-native": "0.546.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11"
  },
  "overrides": {
    "qs": "6.16.0",
    "@xmldom/xmldom": "0.9.12"
  }
}
