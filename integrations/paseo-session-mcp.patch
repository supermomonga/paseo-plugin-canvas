+test("custom provider import receives runtime MCP without returning credentials for persistence", async () => {
+  const harness = createProviderHarness();
+  const registry = new PluginAgentClientRegistry(createTestLogger());
+  try {
+    registry.replace([harness.registration]);
+    const client = registry.clients()[harness.registration.id]!;
+    const storedConfig = { provider: harness.registration.id, cwd: "/workspace" };
+    const first = await client.createSession(storedConfig);
+    const handle = first.describePersistence()!;
+    await first.close();
+    const mcpServers = {
+      canvas: {
+        type: "http" as const,
+        url: "http://127.0.0.1:1234/mcp",
+        headers: { Authorization: "Bearer runtime-only" },
+      },
+    };
+    const imported = await client.importSession!(
+      { providerHandleId: handle.sessionId, cwd: "/workspace" },
+      { config: { ...storedConfig, mcpServers }, storedConfig },
+    );
+    expect(harness.inputs.filter((input) => input.type === "session.open").at(-1)).toMatchObject({
+      config: { mcpServers },
+    });
+    expect(imported.config.mcpServers).toBeUndefined();
+    await imported.session.close();
+  } finally {
+    await registry.shutdown();
+  }
+});
