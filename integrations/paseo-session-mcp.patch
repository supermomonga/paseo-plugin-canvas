+test("session-open MCP credentials reach providers without entering persisted configuration", async () => {
+  const workdir = mkdtempSync(join(tmpdir(), "session-open-mcp-"));
+  const storage = new AgentStorage(join(workdir, "agents"), logger);
+  const client = new McpCapableTestAgentClient();
+  let generation = 0;
+  const manager = new AgentManager({
+    clients: { codex: client },
+    registry: storage,
+    logger,
+    pluginLifecycle: {
+      emit() {},
+      async before(name, request) {
+        if (name !== "agent.session_open") return request;
+        const scoped = request as import("@getpaseo/plugin/server").PluginSessionOpenRequest;
+        return {
+          ...scoped,
+          mcpServers: {
+            ...scoped.mcpServers,
+            canvas: {
+              type: "http" as const,
+              url: "http://127.0.0.1:1234/mcp",
+              headers: { Authorization: `Bearer credential-${++generation}` },
+            },
+          },
+        } as typeof request;
+      },
+    },
+  });
+  try {
+    const created = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+      workspaceId: "workspace",
+    });
+    expect(client.createdConfigs[0].mcpServers?.canvas).toMatchObject({
+      headers: { Authorization: "Bearer credential-1" },
+    });
+    expect(created.config.mcpServers?.canvas).toBeUndefined();
+    expect((await storage.get(created.id))?.config.mcpServers?.canvas).toBeUndefined();
+    await manager.reloadAgentSession(created.id);
+    const launch = client.resumeOverrides.at(-1) ?? client.createdConfigs.at(-1);
+    expect(launch?.mcpServers?.canvas).toMatchObject({
+      headers: { Authorization: "Bearer credential-2" },
+    });
+    expect((await storage.get(created.id))?.config.mcpServers?.canvas).toBeUndefined();
+    const resumed = await manager.resumeAgentFromPersistence(
+      { provider: "codex", sessionId: "session-resume", metadata: { cwd: workdir } },
+      { cwd: workdir },
+      undefined,
+      { workspaceId: "workspace" },
+    );
+    expect(client.resumeOverrides.at(-1)?.mcpServers?.canvas).toMatchObject({
+      headers: { Authorization: "Bearer credential-3" },
+    });
+    expect((await storage.get(resumed.id))?.config.mcpServers?.canvas).toBeUndefined();
+  } finally {
+    await Promise.all(manager.listAgents().map((agent) => manager.closeAgent(agent.id)));
+    rmSync(workdir, { recursive: true, force: true });
+  }
+});
+
